import { Theme } from "theme.slint";
import { App, DeviceRow, SetupPlugin } from "state.slint";
import { Button, Badge, Toggle, IconButton, Spinner } from "widgets.slint";
import { Icons } from "icons.slint";
import { CapLine } from "more.slint";

// ------------------------------------------------------------------ setup assistant

component SetupRadio inherits Rectangle {
    in property <bool> checked;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: checked ? Theme.accent : Theme.line-strong;
    if checked: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
}

component SetupLanguage inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: Theme.r-md;
    background: ta.has-hover || selected ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        SetupRadio { y: (parent.height - self.height) / 2; checked: selected; }
        Text { text: name; font-size: Theme.fs-md; font-weight: 500; color: Theme.text; vertical-alignment: center; overflow: elide; }
    }
}

component SetupOutput inherits Rectangle {
    in property <DeviceRow> dev;
    height: 52px;
    border-radius: Theme.r-md;
    background: ta.has-hover || dev.selected ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: dev.desc;
    accessible-action-default => { App.setup-pick(dev.name); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.setup-pick(dev.name); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        SetupRadio { y: (parent.height - self.height) / 2; checked: dev.selected; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: dev.desc; font-size: Theme.fs-md; font-weight: 500; color: Theme.text; overflow: elide; }
            Text { text: dev.network ? dev.detail : dev.name; font-size: Theme.fs-sm; color: Theme.text2; overflow: elide; }
        }
        if dev.hardware: Badge { y: (parent.height - self.height) / 2; text: @tr("BIT-PERFECT"); tint: Theme.good; }
        if dev.shared: Badge { y: (parent.height - self.height) / 2; text: @tr("SHARED"); tint: Theme.warn; }
        if dev.network: Badge { y: (parent.height - self.height) / 2; text: dev.badge != "" ? dev.badge : @tr("NETWORK"); tint: Theme.warn; }
        if dev.absent: Badge { y: (parent.height - self.height) / 2; text: @tr("NOT CONNECTED"); tint: Theme.warn; }
    }
}

component SetupFolder inherits HorizontalLayout {
    in property <string> path;
    in property <int> index;
    spacing: 12px;
    padding-left: 12px;
    height: 40px;
    Text { text: path; font-size: Theme.fs-md; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.x;
        tooltip: @tr("Remove folder");
        clicked => { App.setup-remove-folder(index); }
    }
}

// A catalogue plugin: name, description, status, tick and sign-in.
component SetupPluginLine inherits HorizontalLayout {
    in property <SetupPlugin> plugin;
    in property <bool> choosing;
    in property <length> text-width;
    spacing: 12px;
    padding-left: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        Text { text: plugin.name; font-size: Theme.fs-md; font-weight: 600; color: Theme.text; overflow: elide; }
        if plugin.description != "": Text { text: plugin.description; font-size: Theme.fs-sm; color: Theme.text2; wrap: word-wrap; width: text-width; }
        if plugin.status != "": Text { text: plugin.status; font-size: Theme.fs-sm; color: plugin.failed ? Theme.warn : Theme.text3; wrap: word-wrap; width: text-width; }
    }
    if plugin.can-sign-in: Button {
        y: (parent.height - self.height) / 2;
        text: @tr("Sign in");
        clicked => { App.plugin-sign-in(plugin.id); }
    }
    if choosing: Toggle {
        y: (parent.height - self.height) / 2;
        label: plugin.name;
        checked: plugin.checked;
        enabled: !plugin.installed;
        toggled(on) => { App.setup-plugin-check(plugin.id, on); }
    }
}

component SetupHeading inherits Text {
    font-size: Theme.fs-sm;
    font-weight: 700;
    color: Theme.text2;
    height: self.preferred-height + 10px;
    vertical-alignment: bottom;
}

/// Setup assistant (setup.rs): language, music folders, plugins, output,
/// DAC, volume, summary. The language applies at once, plugins when
/// leaving their step (after a confirmation), the rest at Save. Later (or
/// Escape) closes it for good.
export component SetupAssistant inherits Rectangle {
    // Wrapped text gets this width explicitly: its height then covers
    // every line.
    private property <length> body-width: 520px;
    private property <int> step: App.setup-step;
    private property <int> phase: App.setup-plugins-phase;
    // Lists scroll within the window.
    private property <length> list-max: root.height - 340px;
    // The sign-in, install or folder dialogs open above it: the keyboard
    // comes back here when they close.
    private property <bool> covered: App.signin-open || App.root-path-open || App.install-open;
    changed covered => {
        if !covered { keys.focus(); }
    }
    background: Theme.scrim;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                App.setup-skip();
                return accept;
            }
            reject
        }
        Rectangle {
            width: root.body-width + 48px;
            height: lay.preferred-height;
            border-radius: Theme.r-lg;
            background: Theme.overlay;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #000000b3;
            TouchArea { }
            lay := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: @tr("Setup · step {} of {}", step + 1, 7); font-size: Theme.fs-sm; color: Theme.text3; }
                Text {
                    text: step == 0 ? @tr("Language") : step == 1 ? @tr("Music folders") : step == 2 ? (phase == 1 ? @tr("Install these plugins?") : @tr("Plugins")) : step == 3 ? @tr("Choose the output") : step == 4 ? @tr("Check the DAC") : step == 5 ? @tr("Volume") : @tr("Ready");
                    font-size: Theme.fs-xl;
                    font-weight: 700;
                    color: Theme.text;
                }

                if step == 0: Text {
                    text: @tr("The interface switches at once. “System” follows the language of your desktop.");
                    font-size: Theme.fs-md;
                    color: Theme.text2;
                    wrap: word-wrap;
                    width: root.body-width;
                }
                if step == 0: VerticalLayout {
                    for name[i] in App.language-names: SetupLanguage {
                        name: name;
                        selected: i == App.ui-language;
                        clicked => { App.setup-language(i); }
                    }
                }

                if step == 1: Text {
                    text: @tr("ricercar indexes the music in these folders; files are only read, never modified. The list can stay empty if you only play from plugins or from other apps.");
                    font-size: Theme.fs-md;
                    color: Theme.text2;
                    wrap: word-wrap;
                    width: root.body-width;
                }
                if step == 1: ffl := Flickable {
                    height: min(folders.preferred-height, root.list-max);
                    content-height: folders.preferred-height;
                    folders := VerticalLayout {
                        width: ffl.width;
                        for f[i] in App.setup-folders: SetupFolder { path: f; index: i; }
                        if App.setup-folders.length == 0: Text { text: @tr("No music folder yet"); font-size: Theme.fs-md; color: Theme.text3; height: 40px; vertical-alignment: center; }
                    }
                }
                if step == 1: HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Add folder"); icon: Icons.folder-open; clicked => { App.setup-add-folder(); } }
                }

                if step == 2 && phase == 0: Text {
                    text: @tr("Plugins add music from other sources. Each one is a separate program from its author, running with your permissions. Nothing is downloaded before you confirm.");
                    font-size: Theme.fs-md;
                    color: Theme.text2;
                    wrap: word-wrap;
                    width: root.body-width;
                }
                if step == 2 && phase == 2: Text {
                    text: @tr("Plugins that need an account can be signed in now, or later from the Plugins page.");
                    font-size: Theme.fs-md;
                    color: Theme.text2;
                    wrap: word-wrap;
                    width: root.body-width;
                }
                if step == 2 && phase == 0 && App.setup-plugins-loading: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Spinner { y: (parent.height - self.height) / 2; }
                    Text { text: @tr("Loading the catalogue…"); font-size: Theme.fs-md; color: Theme.text2; vertical-alignment: center; }
                }
                if step == 2 && phase == 0 && App.setup-plugins-status != "": Text {
                    text: App.setup-plugins-status;
                    font-size: Theme.fs-md;
                    color: Theme.text3;
                    wrap: word-wrap;
                    width: root.body-width;
                }
                if step == 2 && phase != 1: pfl := Flickable {
                    height: min(plugins.preferred-height, root.list-max);
                    content-height: plugins.preferred-height;
                    plugins := VerticalLayout {
                        width: pfl.width;
                        for p in App.setup-plugins: SetupPluginLine {
                            plugin: p;
                            choosing: phase == 0;
                            text-width: root.body-width - 160px;
                        }
                    }
                }
                if step == 2 && phase == 1: cfl := Flickable {
                    height: min(confirm.preferred-height, root.list-max);
                    content-height: confirm.preferred-height;
                    confirm := VerticalLayout {
                        width: cfl.width;
                        Text { text: App.setup-plugins-confirm; font-size: Theme.fs-md; color: Theme.text; wrap: word-wrap; width: root.body-width; }
                    }
                }

                if step == 3: Text {
                    text: @tr("Hardware outputs (hw:) send the music to the DAC untouched, at each track's own rate. The default and PipeWire outputs go through the system mixer, which may resample.");
                    font-size: Theme.fs-md;
                    color: Theme.text2;
                    wrap: word-wrap;
                    width: root.body-width;
                }
                if step == 3: fl := Flickable {
                    height: min(list.preferred-height, root.list-max);
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        width: fl.width;
                        for d[i] in App.setup-outputs: VerticalLayout {
                            if d.hardware && i == 0: SetupHeading { text: @tr("Bit-perfect (recommended)"); }
                            if !d.hardware && !d.network && (i == 0 || App.setup-outputs[max(i - 1, 0)].hardware): SetupHeading { text: @tr("Shared"); }
                            if d.network && (i == 0 || !App.setup-outputs[max(i - 1, 0)].network): SetupHeading { text: @tr("Network"); }
                            SetupOutput { dev: d; }
                        }
                    }
                }

                if step == 4: VerticalLayout {
                    spacing: 10px;
                    Text { text: App.setup-dev.desc; font-size: Theme.fs-md; font-weight: 600; color: Theme.text; overflow: elide; }
                    if App.setup-dev.caps-status != "": Text { text: App.setup-dev.caps-status; font-size: Theme.fs-sm; color: Theme.text3; wrap: word-wrap; width: root.body-width; }
                    if App.setup-dev.caps-known: CapLine { label: @tr("Sample rates"); chips: App.setup-dev.rates; }
                    if App.setup-dev.caps-known: CapLine { label: @tr("Containers"); chips: App.setup-dev.formats; }
                    if App.setup-verdict != "": Text { text: App.setup-verdict; font-size: Theme.fs-md; font-weight: 600; color: Theme.good; wrap: word-wrap; width: root.body-width; }
                    if App.setup-note != "": Text { text: App.setup-note; font-size: Theme.fs-md; color: Theme.text2; wrap: word-wrap; width: root.body-width; }
                }

                if step == 5: VerticalLayout {
                    spacing: 14px;
                    Text {
                        text: @tr("With fixed volume, ricercar always plays at 100 % and ignores volume changes, so the samples reach the DAC untouched. You then set the volume on your DAC or amplifier: turn it down before the first track.");
                        font-size: Theme.fs-md;
                        color: Theme.text2;
                        wrap: word-wrap;
                        width: root.body-width;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: @tr("Fixed volume (bit-perfect)"); font-size: Theme.fs-md; font-weight: 500; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                        Toggle { label: @tr("Fixed volume (bit-perfect)"); checked <=> App.setup-fixed; }
                    }
                }

                if step == 6: VerticalLayout {
                    spacing: 8px;
                    for l in App.setup-summary: HorizontalLayout {
                        spacing: 12px;
                        Text { width: 130px; text: l.label; font-size: Theme.fs-md; color: Theme.text3; }
                        Text { text: l.value; font-size: Theme.fs-md; color: Theme.text; wrap: word-wrap; width: root.body-width - 142px; }
                    }
                    Text {
                        text: @tr("You can change all of this later in Settings.");
                        font-size: Theme.fs-sm;
                        color: Theme.text2;
                        wrap: word-wrap;
                        width: root.body-width;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 6px;
                    Button { text: @tr("Later"); clicked => { App.setup-skip(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if step > 0: Button {
                        text: @tr("Back");
                        enabled: step != 2 || !App.setup-plugins-busy;
                        clicked => { App.setup-back(); }
                    }
                    if step < 6: Button {
                        text: step == 2 && phase == 1 ? @tr("Install") : @tr("Next");
                        primary: true;
                        enabled: (step != 3 || App.setup-dev.name != "") && (step != 2 || !App.setup-plugins-busy);
                        clicked => { App.setup-next(); }
                    }
                    if step == 6: Button { text: @tr("Save"); primary: true; clicked => { App.setup-finish(); } }
                }
            }
        }
    }
}
